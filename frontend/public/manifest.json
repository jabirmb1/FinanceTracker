{
  "manifest_version": 3,
  "name": "Finance Tracker",
  "version": "1.0",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons16.png",
    "48": "icon48.png",
    "128": "logo512.png"
  },
  "permissions": ["storage"]
}
